root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4

[*.md]
indent_size = 2
# Preserve intentional Markdown hard breaks.
trim_trailing_whitespace = false

[*.{yml,yaml,json,xml}]
indent_size = 2

[*.{properties,ini,conf}]
indent_size = 4

[{.editorconfig,.gitignore,.env,.env.*}]
indent_size = 2

[mvnw.cmd]
end_of_line = crlf
